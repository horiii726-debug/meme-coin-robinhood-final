# ===== STRATEGI FINAL RHC — salin jadi ".env" di VPS. JANGAN commit file .env. =====
# Nilai di bawah SAMA PERSIS dengan uji maju final ($100 -> $12.746, 2 Ags - 17 Sep).
# Mengubah salah satunya berarti menjalankan strategi yang BELUM diuji.

# --- Jaringan ---
RPC_URLS=https://rpc.mainnet.chain.robinhood.com
# PC rumah Indonesia: ISP membajak DNS -> wajib DoH. Di VPS boleh dikosongkan.
DOH_URL=https://cloudflare-dns.com/dns-query

# --- Masuk ---
FILTER=1            # filter ML CatBoost (wajib 1)
QTHR=0.90           # hanya ambil 10% skor tertinggi dari 100 koin terakhir
HONEYPOT=1          # cek honeypot sebelum beli
DEV_RULE=1          # tolak dompet pembuat yang pernah bikin koin rug

# --- Ukuran & risiko ---
START_USD=100       # modal akun kertas
MAX_POS=10          # maksimal posisi terbuka serentak
EXP_MAX=0.5         # maksimal 50% equity dipertaruhkan serentak
LP_CAP=0.01         # posisi maksimal 1% likuiditas pool (batas fisik pasar)
KELLY_MAKS=0.10     # batas atas 1/4 Kelly per posisi
KILL_DD=0.60        # stop darurat: berhenti beli kalau equity turun 60% dari puncak
REM=1               # rem bertahap: taruhan dikecilkan saat drawdown 10/20/30%

# --- Keluar ---
HZ_LIVE=324000      # batas pegang 9 jam (blok x 0,1 dtk)
DANGER_TH=0.4       # ambang model bahaya
UP_TH=0.5           # model p_naik >= ini -> TAHAN walau ada sinyal bahaya
TP_UP=0.5           # model p_naik >= ini -> TUNDA take profit +20%

# --- Biaya nyata (diukur dari receipt on-chain) ---
GAS_USD=0.06        # gas per swap
FAIL_BUY=0.0185     # peluang beli gagal
FAIL_SELL=0.0054    # peluang jual gagal (per percobaan)

# --- Belajar ---
RETRAIN_TIAP=100    # latih ulang model filter tiap 100 trade tutup
# Windows: python | Linux/VPS: python3
PYTHON=python
