# ===== SETELAN BOT RHC DI VPS (bot Rust, MODE KERTAS) =====
# Strategi = AUDIT07, satu-satunya setelan yang lolos SEMUA uji (4 Okt 2026):
#   Ags-Sep 3 seed $16.291 / $18.204 / $14.224 | Oktober $264,69 | uji acak median $11.656, DD terburuk 5% 33,4%
#   bot Rust di simulasi Oktober = 50/50 koin sama dengan backtest.
# JANGAN ubah angka strategi tanpa uji maju baru.

# --- Jaringan (VPS: DNS normal -> DoH dimatikan) ---
RPC_URLS=https://rpc.mainnet.chain.robinhood.com
DOH_URL=
POLL_MS=300

# --- Masuk ---
FILTER=1
QTHR=0.90
HONEYPOT=1
DEV_RULE=1
LARANG_PEMANASAN=0      # belum diuji di backtest AUDIT07 -> mati
REM_HARIAN=0            # belum diuji di backtest AUDIT07 -> mati

# --- Ukuran & risiko ---
START_USD=100
MAX_POS=5
EXP_MAX=0.5
LP_CAP=0.01
KELLY_MAKS=0.10
KILL_DD=0.60
REM=1

# --- Keluar (AUDIT07) ---
HZ_LIVE=324000
DANGER_TH=0.4
UP_TH=0.5
TP_UP=0.5
TUTUP_SAAT_RUG=1
TRAIL_PUNCAK=0.40
DUMP_FRAC=0.12

# --- Biaya nyata ---
GAS_USD=0.06
FAIL_BUY=0.0185
FAIL_SELL=0.0054

# --- Belajar & operasional ---
LABEL=1                 # simulasi bayangan tiap koin -> labels.jsonl (bahan latih ulang otomatis)
RETRAIN_TIAP=1          # latih ulang dijalankan rhc-latih.timer (gerbang mutu); bot memuat model baru otomatis
CHECKPOINT_BLOK=36000
KOMPAKSI_MB=300
# Notifikasi Telegram (opsional): isi dua baris ini
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
