# Salin jadi .env di VPS. JANGAN commit file .env.
# RPC utama dulu, lalu cadangan (dipisah koma). Pindah otomatis kalau satu gagal.
RPC_URLS=https://rpc.mainnet.chain.robinhood.com
# Kosongkan di VPS (DNS normal). Isi hanya kalau ISP membajak DNS (seperti di koneksi rumah Indonesia).
DOH_URL=
# Filter ML beli (1 = aktif)
FILTER=1
# Cek honeypot sebelum beli (1 = aktif)
HONEYPOT=1
# Akun virtual untuk paper trading
START_USD=100
MAX_POS=20
# Anggap data basi kalau tertinggal lebih dari N blok (300 = 30 detik)
FRESH_BLOCKS=300
